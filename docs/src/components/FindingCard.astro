---
interface Props {
  severity: "critical" | "high" | "medium" | "low" | "info";
  title: string;
  engine: string;
  target: string;
  evidence: string;
}

const { severity, title, engine, target, evidence } = Astro.props;
---
<figure class="finding-card">
  <figcaption>Illustrative finding · not a live scan</figcaption>
  <div class="finding-body" data-severity={severity}>
    <p class="finding-label">Finding / {severity}</p>
    <p class="finding-title">{title}</p>
    <dl>
      <div><dt>Target</dt><dd>{target}</dd></div>
      <div><dt>Engine</dt><dd>{engine}</dd></div>
      <div><dt>Evidence</dt><dd><code>{evidence}</code></dd></div>
    </dl>
  </div>
</figure>
<style>
  .finding-card { margin: 1.5rem 0; padding: 1rem 1.2rem; border: 1px solid rgba(237, 123, 57, 0.3); border-radius: 0.8rem; background: #10131b; color: #e7e8ed; }
  figcaption { margin-bottom: 0.8rem; color: #a2a9b7; font: 0.7rem/1.6 ui-monospace, monospace; text-transform: uppercase; letter-spacing: 0.04em; }
  .finding-body { border-left: 2px solid #ed7b39; padding-left: 0.8rem; font: 0.8rem/1.6 ui-monospace, monospace; }
  .finding-body[data-severity="medium"] { border-color: #e8c27a; }
  .finding-body[data-severity="low"], .finding-body[data-severity="info"] { border-color: #677081; }
  .finding-label { margin: 0 0 0.4rem; color: #f3a171; font-size: 0.7rem; text-transform: uppercase; }
  .finding-title { margin: 0 0 0.75rem; color: #e7e8ed; }
  dl { margin: 0; }
  dl div { display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: 0.5rem; border-top: 1px solid #2b303b; padding: 0.3rem 0; }
  dt { color: #a2a9b7; }
  dd { margin: 0; overflow-wrap: anywhere; }
  code { color: #e7e8ed; background: transparent; padding: 0; }
  @media (max-width: 35rem) { dl div { display: block; } dt { margin-bottom: 0.1rem; } }
</style>
