---
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import { pageGraph, serializeJsonLd } from "../../../shared/seo";

const { entry, head } = Astro.locals.starlightRoute;
const noindex = head.some(({ attrs }) => attrs?.name === "robots" && String(attrs.content).includes("noindex"));
const image = new URL("/og-image.png", Astro.site);
const graph = pageGraph(Astro.site!, {
  path: Astro.url.pathname,
  title: entry.data.title,
  description: entry.data.description ?? "Insidia CLI documentation for local AI and application security testing.",
  documentation: true,
});
---
<DefaultHead />
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Insidia Labs — security testing for AI apps and agents" />
<meta name="twitter:title" content={entry.data.title} />
<meta name="twitter:description" content={entry.data.description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content="Insidia Labs — security testing for AI apps and agents" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="Insidia documentation for language models" />
{!noindex && <script type="application/ld+json" set:html={serializeJsonLd(graph)} />}
