# Public Web Analytics id for insidialabs.com.
# Set this in the Vercel project (Production and Preview), then redeploy.
# Analytics stays off while this is empty. The value is visible in the built pages.
# After you enable Web Analytics, copy the project DSN from the Vercel Analytics setup.
PUBLIC_VERCEL_ANALYTICS_ID=

# Set to 1 to keep analytics off even when PUBLIC_VERCEL_ANALYTICS_ID is set.
PUBLIC_VERCEL_ANALYTICS_DISABLED=
