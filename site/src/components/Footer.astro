---
import { docsCli, docsHome, docsQuickstart } from "../lib/paths";

const groups = [
  {
    title: "Product",
    links: [
      ["/#how", "How it works"],
      ["/pricing", "Pricing"],
      ["/changelog", "Changelog"],
      ["/#faq", "FAQ"],
      ["/film", "Film"],
    ],
  },
  {
    title: "Developers",
    links: [
      [docsHome, "Docs"],
      [docsQuickstart, "Quickstart"],
      [docsCli, "CLI reference"],
      ["/credits", "Credits"],
    ],
  },
  {
    title: "Company",
    links: [
      ["https://github.com/Rushi-Balapure/Insidia-Labs", "GitHub"],
      ["mailto:insidialabs@gmail.com", "Contact"],
      ["/security", "Security"],
    ],
  },
];
---
<footer class="site-footer">
  <div class="wrap foot-grid">
    <p>Insidia Labs. Built in Pune, India.</p>
    {groups.map((group) => (
      <nav aria-label={group.title}>
        <h2>{group.title}</h2>
        {group.links.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
    ))}
  </div>
</footer>
