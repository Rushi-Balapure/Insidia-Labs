---
interface Props {
  path: string;
  dsn: string;
}

const { path, dsn } = Astro.props;
---

<insidia-analytics data-path={path} data-dsn={dsn}></insidia-analytics>

<script>
  import { pageUrl, type TrackedPath } from "../lib/analytics";

  const tag = "insidia-analytics";

  function trackedPath(value: string | undefined): TrackedPath | null {
    if (value === "/site" || value === "/documentation") return value;
    return null;
  }

  function queue(name: "va" | "si") {
    const host = window as unknown as Record<string, (...args: unknown[]) => void>;
    const existing = host[name];
    if (typeof existing === "function") return existing;
    const key = name === "va" ? "vaq" : "siq";
    const fn = (...params: unknown[]) => {
      const bucket = (host[key] as unknown as unknown[] | undefined) ?? [];
      bucket.push(params);
      host[key] = bucket as unknown as (...args: unknown[]) => void;
    };
    host[name] = fn;
    return fn;
  }

  function addScript(src: string, dataset: Record<string, string>) {
    if (document.head.querySelector("script[src='" + src + "']")) return;
    const script = document.createElement("script");
    script.src = src;
    script.defer = true;
    for (const [key, value] of Object.entries(dataset)) script.dataset[key] = value;
    document.head.appendChild(script);
  }

  if (!customElements.get(tag)) {
    customElements.define(
      tag,
      class extends HTMLElement {
        connectedCallback() {
          if (this.dataset.ready === "1") return;
          const path = trackedPath(this.dataset.path);
          const dsn = this.dataset.dsn?.trim();
          if (!path || !dsn) return;
          this.dataset.ready = "1";
          const urlFor = (current: string) => pageUrl(current, path, window.location.href);
          const va = queue("va");
          va("beforeSend", (event: { url: string }) => ({ ...event, url: urlFor(event.url) }));
          addScript("/_vercel/insights/script.js", {
            dsn,
            sdkn: "@vercel/analytics",
            sdkv: "2.0.1",
            disableAutoTrack: "1",
          });
          va("pageview", { path, route: path });
          const si = queue("si");
          si("beforeSend", (event: { url: string }) => ({ ...event, route: path, url: urlFor(event.url) }));
          addScript("/_vercel/speed-insights/script.js", {
            sdkn: "@vercel/speed-insights",
            sdkv: "2.0.0",
            route: path,
          });
        }
      },
    );
  }
</script>
