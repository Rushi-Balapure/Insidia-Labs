---
import { readFileSync } from "node:fs";
import type { Brand } from "../content/brands";

interface Props {
  label: string;
  items: Brand[];
}
const { label, items } = Astro.props;
const headingId = label.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

function mark(file: string) {
  let raw = readFileSync(new URL(`../../public/brands/${file}`, import.meta.url), "utf8");
  raw = raw.replace(/<title>[\s\S]*?<\/title>/g, "");
  raw = raw.replace(/<svg\b/, '<svg class="brand-svg" aria-hidden="true" focusable="false"');
  if (!raw.includes("fill=")) raw = raw.replace("<path", '<path fill="currentColor"');
  return raw;
}

const rendered = items.map((item) => ({
  ...item,
  svg: item.kind === "svg" ? mark(item.file) : "",
}));
const copies = [0, 1];
---
<section class="marquee" aria-labelledby={headingId}>
  <insidia-marquee>
  <div class="marquee-heading"><h2 class="marquee-label" id={headingId}>{label}</h2><button type="button" aria-label="Pause logo animation" hidden>Pause <span aria-hidden="true">Ⅱ</span></button></div>
  <div class="marquee-window">
    <div class="marquee-track" style={`--copies: ${copies.length}`}>
      {copies.map((copy) => (
        <ul class="marquee-group" aria-hidden={copy === 0 ? undefined : "true"}>
          {rendered.map((item) => (
            <li class="brand" style={`font-family: ${item.font}`}>
              {item.kind === "svg" ? (
                <span class="brand-svg-wrap" set:html={item.svg} />
              ) : (
                <img class={item.plate ? `plate-${item.plate}` : undefined} src={`/brands/${item.file}`} alt={item.wordmark ? item.name : ""} width="120" height="32" />
              )}
              {item.wordmark ? null : <span>{item.name}</span>}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
  </insidia-marquee>
</section>
<script>
  class InsidiaMarquee extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";
      const button = this.querySelector("button");
      if (!button) return;
      button.hidden = false;
      this.dataset.animated = "true";
      button.addEventListener("click", () => {
        const paused = this.dataset.paused !== "true";
        this.dataset.paused = String(paused);
        button.setAttribute("aria-label", paused ? "Resume logo animation" : "Pause logo animation");
        button.textContent = paused ? "Resume ▷" : "Pause Ⅱ";
      });
    }
  }
  if (!customElements.get("insidia-marquee")) customElements.define("insidia-marquee", InsidiaMarquee);
</script>
