---
interface Props {
  id: string;
  question: string;
}
const { id, question } = Astro.props;
---
<details class="accordion-item" name="homepage-faq">
  <summary class="accordion-trigger" id={`${id}-trigger`}>
    <span>{question}</span>
    <span class="accordion-chevron" aria-hidden="true"></span>
  </summary>
  <div class="accordion-panel" id={`${id}-panel`} role="region" aria-labelledby={`${id}-trigger`}>
    <div class="accordion-panel-inner"><slot /></div>
  </div>
</details>
