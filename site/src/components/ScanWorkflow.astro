---
const steps = [
  { title: "Set the boundary", text: "Point Insidia at your running app. Choose exactly which hosts it may test.", lines: ["insidia init --url http://127.0.0.1:8080/chat", "insidia doctor"], note: "Your target and allowed hosts are saved in insidia.yaml." },
  { title: "Run the scan", text: "Start with the L1 baseline. Review findings and the checks that could not run.", lines: ["insidia scan --policy L1", "insidia report --open"], note: "The report includes evidence, remediation, engine names, and coverage." },
  { title: "Fix and repeat", text: "Update your app, then repeat the same checks with the recorded policy and coverage.", lines: ["insidia rerun", "insidia report --open"], note: "Compare the new findings with the previous report to review your changes." },
];
---
<insidia-workflow class="scan-workflow">
  <ol class="workflow-steps">
    {steps.map((step, i) => (
      <li class="workflow-step">
        <p class="eyebrow">Step 0{i + 1}</p>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
        <div class="step-cli">
          <p class="visually-hidden">{step.lines.join("\n")}</p>
          <div class="step-cli-chrome" aria-hidden="true">
            <span class="terminal-lights"><i></i><i></i><i></i></span>
            <span>insidia</span>
          </div>
          <div class="step-cli-body" aria-hidden="true">
            {step.lines.map((line) => (
              <p class="step-line"><span class="step-prompt">❯</span><span class="step-typed" data-command={line}></span></p>
            ))}
          </div>
        </div>
        <small>{step.note}</small>
      </li>
    ))}
  </ol>
  <div class="workflow-replay">
    <button type="button" hidden>Replay steps <span aria-hidden="true">↻</span></button>
  </div>
</insidia-workflow>
<script>
  class InsidiaWorkflow extends HTMLElement {
    private listeners = new AbortController();
    private run = new AbortController();

    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";
      this.listeners = new AbortController();
      const { signal } = this.listeners;
      const button = this.querySelector("button");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
      const steps = [...this.querySelectorAll<HTMLElement>(".workflow-step")];
      if (!button) return;

      const fill = () => {
        for (const step of steps) {
          step.removeAttribute("data-active");
          for (const line of step.querySelectorAll<HTMLElement>(".step-line")) {
            line.removeAttribute("data-typing");
            const typed = line.querySelector<HTMLElement>(".step-typed");
            if (typed) typed.textContent = typed.dataset.command ?? "";
          }
        }
      };

      const play = () => {
        this.run.abort();
        this.run = new AbortController();
        const runSignal = this.run.signal;
        for (const step of steps) {
          step.removeAttribute("data-active");
          for (const line of step.querySelectorAll<HTMLElement>(".step-line")) {
            line.removeAttribute("data-typing");
            const typed = line.querySelector<HTMLElement>(".step-typed");
            if (typed) typed.textContent = "";
          }
        }
        if (reduce.matches) {
          fill();
          return;
        }
        void this.typeSteps(steps, runSignal);
      };

      button.hidden = reduce.matches;
      button.addEventListener("click", play, { signal });
      reduce.addEventListener("change", () => {
        button.hidden = reduce.matches;
        if (reduce.matches) {
          this.run.abort();
          fill();
        }
      }, { signal });

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          if (reduce.matches) fill();
          else play();
        }, { threshold: 0.2 });
        observer.observe(this);
        signal.addEventListener("abort", () => observer.disconnect(), { once: true });
      } else if (reduce.matches) {
        fill();
      } else {
        play();
      }
    }

    private async typeSteps(steps: HTMLElement[], signal: AbortSignal) {
      const wait = (ms: number) => new Promise<void>((resolve, reject) => {
        if (signal.aborted) {
          reject(new DOMException("Aborted", "AbortError"));
          return;
        }
        const id = window.setTimeout(resolve, ms);
        signal.addEventListener("abort", () => {
          window.clearTimeout(id);
          reject(new DOMException("Aborted", "AbortError"));
        }, { once: true });
      });
      try {
        for (const step of steps) {
          if (signal.aborted) return;
          step.dataset.active = "true";
          for (const line of step.querySelectorAll<HTMLElement>(".step-line")) {
            const typed = line.querySelector<HTMLElement>(".step-typed");
            const text = typed?.dataset.command ?? "";
            line.dataset.typing = "true";
            for (let i = 1; i <= text.length; i++) {
              if (signal.aborted) return;
              if (typed) typed.textContent = text.slice(0, i);
              await wait(32);
            }
            line.removeAttribute("data-typing");
            await wait(160);
          }
          step.removeAttribute("data-active");
          await wait(420);
        }
      } catch (error) {
        if (!(error instanceof DOMException) || error.name !== "AbortError") throw error;
      }
    }

    disconnectedCallback() {
      this.listeners.abort();
      this.run.abort();
      delete this.dataset.ready;
    }
  }
  if (!customElements.get("insidia-workflow")) customElements.define("insidia-workflow", InsidiaWorkflow);
</script>
