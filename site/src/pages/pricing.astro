---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LeadForm from "../components/LeadForm.tsx";

const description = "Run the Insidia CLI for free. Insidia Cloud is in development, with design-partner access planned for December 2026.";
const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT ?? "";
---
<Base title="Pricing | Insidia Labs" description={description} path="/pricing">
  <Header />
  <main id="content" class="wrap page">
    <h1>The CLI is free.</h1>
    <p class="lede">Run scans on your machine or in CI. No account required.</p>
    <div class="grid-2">
      <article class="card">
        <h2>CLI</h2>
        <p class="price-label">Free</p>
        <ul>
          <li>Scan on your machine or in CI. No account.</li>
          <li>AI checks and app checks in one run. Every finding names its engine.</li>
          <li>HTML report, JSON, and SARIF.</li>
          <li>Your model, or none. Many checks need no model.</li>
        </ul>
        <a class="btn" href="/#install">Get started</a>
      </article>
      <article class="card">
        <h2>Insidia Cloud</h2>
        <p class="price-label">In development</p>
        <p>Hosted attack generation, with design-partner access planned for December 2026. Pricing has not been announced. Get in touch to discuss your team's needs.</p>
        <a class="btn ghost" href="mailto:insidialabs@gmail.com?subject=Book%20a%20call">Book a call</a>
      </article>
    </div>
    <section class="block" id="access">
      <h2>Ask about design-partner access</h2>
      <p class="muted">Tell us what you are building and what you need to test. You can use the CLI today without joining the waitlist.</p>
      <LeadForm client:load endpoint={endpoint} />
    </section>
  </main>
  <Footer />
</Base>
