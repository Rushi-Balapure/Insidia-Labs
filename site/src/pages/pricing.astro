---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LeadForm from "../components/LeadForm.tsx";

const description = "Use the free Insidia CLI and agent skill for local or CI security scans. No account required. See what's included and the development status of Insidia Cloud.";
const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT ?? "";
---
<Base title="Free AI Security Testing CLI & Pricing | Insidia Labs" description={description} path="/pricing">
  <Header />
  <main id="content" class="wrap page">
    <h1>Start testing for free.</h1>
    <p class="lede">Use Insidia on your machine, through your coding agent, or in CI. No Insidia account required.</p>
    <div class="grid-2">
      <article class="card">
        <h2>CLI + agent skill</h2>
        <p class="price-label">Free</p>
        <ul>
          <li>CLI for local and CI scans.</li>
          <li>Agent skill for setup, scanning, and report review.</li>
          <li>HTML reports for review, plus JSON and SARIF for automation.</li>
          <li>L1 baseline without a model; optional model endpoints you configure.</li>
        </ul>
        <p class="muted">Coverage varies by target and engine. Paid model services you choose have their own costs.</p>
        <a class="btn" href="/#agent-skill">Use the agent skill</a>
        <a href="/#install">Install the CLI</a>
      </article>
      <article class="card">
        <h2>Insidia Cloud</h2>
        <p class="price-label">In development</p>
        <p>Interested in hosted attack generation for your team? Design-partner access is planned for December 2026. Pricing has not been announced.</p>
        <a class="btn ghost" href="mailto:insidialabs@gmail.com?subject=Book%20a%20call">Book a call</a>
      </article>
    </div>
    <section class="block" id="access">
      <h2>Ask about design-partner access</h2>
      <p class="muted">Tell us what you are building and what you need to test. The CLI and skill are available now; joining the waitlist is optional.</p>
      <LeadForm client:load endpoint={endpoint} />
    </section>
  </main>
  <Footer />
</Base>
