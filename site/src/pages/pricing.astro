---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LeadForm from "../components/LeadForm.tsx";
import FaqThread from "../components/FaqThread.astro";
import { faqs } from "../content/faqs";
import "../styles/pricing.css";

const description = "Use the free Insidia CLI and agent skill for local or CI security scans. No account required. See what's included and the development status of Insidia Cloud.";
const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT ?? "";
const freePoints = [
  "CLI for local and CI scans.",
  "Agent skill for setup, scanning, and report review.",
  "HTML reports for review, plus JSON and SARIF for automation.",
  "L1 baseline without a model. Optional model endpoints you configure.",
  "Coverage depends on the target and the engines you install.",
];
const cloudPoints = [
  "Hosted attack generation for your team.",
  "Design-partner access is planned for December 2026.",
  "Pricing has not been announced.",
  "Tell us what you are building and what you need to test.",
  "The CLI and agent skill stay free either way.",
];
---
<Base title="Free AI Security Testing CLI & Pricing | Insidia Labs" description={description} path="/pricing">
  <Header />
  <main id="content" class="pricing-page">
    <section class="wrap" aria-labelledby="pricing-heading">
      <div class="pricing-intro">
        <h1 id="pricing-heading">Start testing for free.</h1>
        <p>Use Insidia on your machine, through your coding agent, or in CI. No Insidia account required.</p>
      </div>
      <div class="plan-grid">
        <article class="plan">
          <div class="plan-art"><img src="/pricing/free.jpg" alt="" width="1280" height="720" /></div>
          <div class="plan-body">
            <h2>Free</h2>
            <p class="plan-for">For local scans, your coding agent, and CI.</p>
            <p class="plan-price"><b>$0</b><span>forever</span></p>
            <a class="plan-btn plan-btn-line" href="/#agent-skill">Use the agent skill</a>
            <ul class="plan-points">
              {freePoints.map((point) => <li>{point}</li>)}
            </ul>
          </div>
        </article>
        <article class="plan plan-pro">
          <div class="plan-art"><img src="/pricing/pro.jpg" alt="" width="1280" height="720" /></div>
          <div class="plan-body">
            <h2>Cloud</h2>
            <p class="plan-for">For hosted scans, when your team is ready.</p>
            <p class="plan-price"><b>Soon</b><span>pricing has not been announced</span></p>
            <a class="plan-btn" href="mailto:insidialabs@gmail.com?subject=Book%20a%20call">Book a call</a>
            <ul class="plan-points">
              {cloudPoints.map((point) => <li>{point}</li>)}
            </ul>
          </div>
        </article>
      </div>
      <p class="plan-note">Prefer to <a href="/#install">install the CLI</a> yourself. Paid model services you configure have their own costs.</p>
    </section>

    <section class="pricing-faq" id="faq" aria-labelledby="pricing-faq-heading">
      <div class="wrap faq-layout">
        <div>
          <p class="eyebrow">Before your first scan</p>
          <h2 id="pricing-faq-heading">A few useful answers.</h2>
          <p>Need help with a specific setup?</p>
          <a class="text-link" href="/docs/">Open the documentation <span aria-hidden="true">↗</span></a>
        </div>
        <FaqThread items={faqs} name="pricing-faq" />
      </div>
    </section>

    <section class="wrap block pricing-access" id="access">
      <h2>Ask about design-partner access</h2>
      <p class="muted">Tell us what you are building and what you need to test. The CLI and skill are available now; joining the waitlist is optional.</p>
      <LeadForm client:load endpoint={endpoint} />
    </section>
  </main>
  <Footer />
</Base>
