---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const description = "The Insidia CLI is free. Insidia Cloud is request-access. This site has no checkout.";
---
<Base title="Pricing | Insidia Labs" description={description} path="/pricing">
  <Header />
  <main id="content" class="wrap" style="padding:3rem 0 4rem">
    <h1>Free CLI. Paid GPUs.</h1>
    <p class="lede">There is no checkout on this site, and no price we have not set. You pay for hosted work. The code, including the Cloud code, stays Apache-2.0.</p>
    <div class="grid-3" style="margin-top:2rem">
      <article class="card">
        <h2>CLI</h2>
        <p>Free. Install from GitHub and scan on your machine or in CI. Engines, Insidia modules, your own model or none, HTML, SARIF, and JSON.</p>
        <a class="btn" href="/#install">Get the CLI</a>
      </article>
      <article class="card">
        <h2>Insidia Cloud</h2>
        <p>Hosted attacker and judge, custom and multi-turn attacks, and later a dashboard to launch and schedule scans. Usage is metered. Early access opens in December 2026.</p>
        <a class="btn ghost" href="/#waitlist">Request access</a>
      </article>
      <article class="card">
        <h2>Design partner</h2>
        <p>Three teams. Three months of access and a short call every two weeks. Staging targets only, with written authorization.</p>
        <a class="btn ghost" href="mailto:insidialabs@gmail.com?subject=Design%20partner">Book a call</a>
      </article>
    </div>
  </main>
  <Footer />
</Base>
