---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Marquee from "../components/Marquee.astro";
import Exhibit from "../components/Exhibit.astro";
import StepCard from "../components/StepCard.astro";
import FeatureCard from "../components/FeatureCard.astro";
import InstallLine from "../components/InstallLine.tsx";
import TraceHero from "../components/TraceHero.tsx";
import VideoModal from "../components/VideoModal.tsx";
import { changelog } from "../content/changelog";
import { engineBrands, stackBrands } from "../content/brands";
import { filmVideo, howtoVideo } from "../lib/video";
import { docsQuickstart, docsTests } from "../lib/paths";

const description = "Insidia attacks your AI app and the API behind it, names the check that failed, and blocks the release until it's fixed.";
const latest = changelog[0];
const pill = `New · ${latest.pill}`;
const faqs = [
  ["What does Insidia test?", `AI and agent checks, plus app and API checks, in one scan. Each result names the check and the engine. The support notes are in the docs.`],
  ["Does anything leave my machine?", "Traffic goes to the target you configured and, if you set one, to your model. There is no telemetry."],
  ["Which engines does it run?", "A finding names the engine that produced it. The list, with each engine's license, is on the Credits page."],
  ["Can my coding agent run it?", "Install the skill, or paste: Test this app with Insidia. Only scan localhost. Claude Code, Cursor, or Codex can run it. You confirm the hosts."],
  ["Will it test production?", "Only hosts you list in insidia.yaml. Anything other than localhost needs authorized: true, which you set."],
  ["What does it cost?", "The CLI is free. It runs on your machine and does not need an account. Insidia Cloud, a hosted attacker, opens to design partners first, from December 2026. This site has no price yet."],
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "Insidia Labs",
      url: "/",
      logo: "/brand/mark-small.svg",
      email: "insidialabs@gmail.com",
      description,
    },
    {
      "@type": "SoftwareApplication",
      name: "Insidia",
      applicationCategory: "SecurityApplication",
      operatingSystem: "Linux, macOS, Windows",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      description: "CLI for security testing of AI apps, agents, web apps, and APIs. Runs on your machine. Every finding names the engine that produced it.",
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map(([name, text]) => ({
        "@type": "Question",
        name,
        acceptedAnswer: { "@type": "Answer", text },
      })),
    },
  ],
};
const scopeYaml = `scope:
  - host: 127.0.0.1
  - host: staging.example.com
    authorized: true`;
const scanRows = `support-bot
  ✔ ai.prompt_injection_direct     pass
  ✘ ai.prompt_injection_indirect   FAIL
  ✔ ai.data_leakage                pass`;
const rerunRows = `$ insidia rerun
  ✔ ai.prompt_injection_indirect   pass   insidia
RELEASE OK · exit 0`;
const retrieval = `def build_prompt(question, docs):
    context = "\\n".join(d.text for d in docs)   # uploaded files, unfiltered
    return SYSTEM + context + question`;
---
<Base title="Insidia Labs | Your AI agent is your newest attack surface." description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Header />
  <main id="content">
    <div class="wrap hero">
      <div>
        <p class="pill"><a href="/changelog">{pill}</a></p>
        <h1>Your AI agent is your newest attack surface.</h1>
        <p class="lede">{description}</p>
        <div class="cta-row">
          <a class="btn" href="#install">Get started</a>
          <VideoModal client:load sources={filmVideo} />
        </div>
        <div id="install">
          <InstallLine client:load />
        </div>
        <p class="muted install-more">Python 3.12 or newer. The <a href={docsQuickstart}>quickstart</a> is the rest of the first run.</p>
      </div>
      <TraceHero which="blocked" live />
    </div>

    <section class="howto-band" aria-labelledby="howto-heading">
      <div class="wrap">
        <h2 id="howto-heading">How to use Insidia</h2>
        <video class="howto-player" controls playsInline poster={howtoVideo.poster} preload="metadata">
          <source src={howtoVideo.webm} type="video/webm" />
          <source src={howtoVideo.mp4} type="video/mp4" />
          <track kind="captions" src={howtoVideo.vtt} srcLang="en" label="English" default />
        </video>
      </div>
    </section>

    <div class="marquee-band">
      <Marquee label="Fits the stack you already ship" items={stackBrands} />
      <Marquee label="Runs the engines you already trust" items={engineBrands} />
    </div>

    <section class="block" id="problem">
      <div class="wrap">
        <h2>Your chatbot passed review. It also obeys the PDF.</h2>
        <Exhibit
          file="support_bot/retrieval.py"
          code={retrieval}
          annotation="← a hidden line in an upload becomes an instruction. Nothing raises."
        />
        <ol class="beats">
          <li>
            <p class="kicker">01</p>
            <h3>No error.</h3>
            <p>The bot answers politely. Logs look clean.</p>
          </li>
          <li>
            <p class="kicker">02</p>
            <h3>Two halves, two tools.</h3>
            <p>The model call and the API it drives usually get tested by different tools, on different days.</p>
          </li>
          <li>
            <p class="kicker">03</p>
            <h3>It ships.</h3>
            <p>The instruction in the document reaches production with everything else.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="block" id="how">
      <div class="wrap">
        <h2>Point it at your app. Get the finding, the evidence, and the fix.</h2>
        <div class="grid-3">
          <StepCard n="01" title="Scope in one file." text="insidia init writes insidia.yaml. Only hosts you list get tested. Anything other than localhost needs authorized: true.">
            <Exhibit file="insidia.yaml" code={scopeYaml} />
          </StepCard>
          <StepCard n="02" title="Scan both layers." text="insidia scan runs AI and app checks in one pass and names the engine behind every result. A check that couldn't run is marked incomplete, never passed.">
            <Exhibit file="insidia scan" code={scanRows} representative />
          </StepCard>
          <StepCard n="03" title="Block the release, prove the fix." text="The scan exits 1 in CI. Fix the code, then insidia rerun checks again with the same config and policy.">
            <Exhibit file="insidia rerun" code={rerunRows} representative />
          </StepCard>
        </div>
      </div>
    </section>

    <section class="block" id="breaks">
      <div class="wrap">
        <h2>Built for how AI apps break</h2>
        <div class="grid-4">
          <FeatureCard
            title="Scope guard"
            code={`scope:\n  - host: staging.example.com\n    authorized: true`}
            line="It refuses to test a host you didn't list."
          />
          <FeatureCard
            title="Evidence, not a score"
            code={`engine: insidia\nprobe: prompt-injection.indirect\nevidence: [AWS_ACCESS_KEY len=20 fp=3f9a1c07]\nfix: keep uploaded text out of the system prompt`}
            line="Every finding shows the attack, the reply, and which engine caught it."
          />
          <FeatureCard
            title="Hand it to your coding agent"
            code={`Test this app with Insidia. Only scan localhost.`}
            line="Claude Code, Cursor, or Codex runs it. You confirm the hosts."
          />
          <FeatureCard
            title="Local, your keys"
            code={`models:\n  attacker:\n    provider: ollama`}
            line="Scans run on your machine. Bring any model, or none: many checks need no model."
          />
        </div>
      </div>
    </section>

    <section class="block" id="faq">
      <div class="wrap">
        <h2>FAQ</h2>
        {faqs.map(([q, a], i) => (
          <details class="faq">
            <summary>{q}</summary>
            <p>
              {a}
              {i === 0 ? <> See <a href={docsTests}>what it tests</a>.</> : null}
              {i === 2 ? <> See <a href="/credits">Credits</a>.</> : null}
            </p>
          </details>
        ))}
      </div>
    </section>

    <section class="block end-cta">
      <div class="wrap end-grid">
        <div>
          <h2>Ship AI you'd attack yourself.</h2>
          <div class="cta-row">
            <a class="btn" href="#install">Get started</a>
            <a class="btn ghost" href="mailto:insidialabs@gmail.com?subject=Book%20a%20call">Book a call</a>
          </div>
        </div>
        <TraceHero which="clear" />
      </div>
    </section>
  </main>
  <Footer />
</Base>
