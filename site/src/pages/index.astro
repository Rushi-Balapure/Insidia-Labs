---
import Base from "../layouts/Base.astro";
import ScanTerminal from "../components/ScanTerminal.astro";
import ScanWorkflow from "../components/ScanWorkflow.astro";
import CommandBlock from "../components/CommandBlock.astro";
import FaqThread from "../components/FaqThread.astro";
import { faqs } from "../content/faqs";
import "../styles/home.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Marquee from "../components/Marquee.astro";
import InstallLine from "../components/InstallLine.tsx";
import VideoModal from "../components/VideoModal.tsx";
import { engineBrands, stackBrands } from "../content/brands";
import { CLI_VERSION, GITHUB_REPO, RELEASE_URL } from "../content/install";
import { howtoVideo } from "../lib/video";
import PageAnalytics from "../components/PageAnalytics.astro";
import GradientCTABanner from "../components/GradientCTABanner.astro";
import { TRACKED_PATHS } from "../lib/analytics";
import { docsAgent, docsQuickstart, docsTests } from "../lib/paths";
import { serializeJsonLd } from "../../../shared/seo";

const description = "Test AI apps, agents, web apps, and APIs for prompt injection, data leakage, and vulnerabilities. Run Insidia's free CLI locally and review evidence in one report.";
const skillInstall = `npx skills add ${GITHUB_REPO}`;
const skillPrompt = `Use the Insidia skill to test my app at http://127.0.0.1:8080/chat.
Only scan localhost. Review the findings and open the report when you're done.`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": new URL("/#software", Astro.site).href,
      name: "Insidia",
      url: Astro.site?.href,
      applicationCategory: "SecurityApplication",
      operatingSystem: "Linux, macOS, Windows",
      publisher: { "@id": new URL("/#organization", Astro.site).href },
      mainEntityOfPage: { "@id": new URL("/#webpage", Astro.site).href },
      softwareRequirements: "Python 3.12 or newer",
      installUrl: new URL("/docs/start/install/", Astro.site).href,
      softwareHelp: { "@type": "WebPage", url: new URL("/docs/", Astro.site).href },
      license: "https://github.com/Rushi-Balapure/Insidia-Labs/blob/main/LICENSE",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      description: "CLI for security testing of AI apps, agents, web apps, and APIs. Runs on your machine. Every finding names the engine that produced it.",
    },
    {
      "@type": "FAQPage",
      "@id": new URL("/#faq", Astro.site).href,
      isPartOf: { "@id": new URL("/#webpage", Astro.site).href },
      mainEntity: faqs.map(({ question, answer }) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: { "@type": "Answer", text: answer },
      })),
    },
  ],
};
---
<Base title="AI Security Testing for Apps & Agents | Insidia Labs" description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
  </Fragment>
  <Header />
  <main id="content" class="home">
    <section class="hero-section" aria-labelledby="hero-heading">
      <div class="wrap hero-layout">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span>Security testing for AI apps &amp; agents</p>
          <h1 id="hero-heading">Your AI agent is your newest <span>attack surface.</span></h1>
          <p class="hero-description">Test the AI behavior and the application behind it. Find the weakness, inspect the evidence, and rerun the check after a fix.</p>
          <div class="cta-row">
            <a class="btn" href="#agent-skill">Use with your agent <span aria-hidden="true">↗</span></a>
            <a class="btn ghost" href={docsQuickstart}>CLI quickstart <span aria-hidden="true">→</span></a>
          </div>
          <div id="install" class="hero-install"><InstallLine client:load /></div>
          <p class="hero-requirements"><a href={RELEASE_URL}>v{CLI_VERSION}</a> · Free CLI · Python 3.12+ · No account required</p>
        </div>
        <ScanTerminal />
      </div>
    </section>

    <div class="integration-strip">
      <div class="wrap"><Marquee label="Your coding workflow. Your security engines." items={[...stackBrands, ...engineBrands]} /></div>
    </div>

    <section class="home-section" id="problem" aria-labelledby="problem-heading">
      <div class="wrap">
        <div class="section-intro">
          <div><p class="eyebrow">01 / What a scan covers</p><h2 id="problem-heading">The AI behavior and<br />the application behind it.</h2></div>
          <p>One scan checks both. Findings name the engine that produced them, and checks that could not run stay visible.</p>
        </div>
        <div class="coverage-grid">
          <article>
            <span class="feature-index">01 / AI and agents</span>
            <h3>Prompt injection, leakage, and tool use.</h3>
            <p>Direct and indirect prompt injection, data leakage, tool misuse, and supply-chain checks for skills and MCP. What runs depends on the target and the engines you have installed.</p>
          </article>
          <article>
            <span class="feature-index">02 / Web apps and APIs</span>
            <h3>The application your agent can reach.</h3>
            <p>Template injection, command injection, path access, SSRF, and related authorization checks. The L1 baseline runs without a model.</p>
          </article>
          <article>
            <span class="feature-index">03 / The report</span>
            <h3>What ran, what failed, what was skipped.</h3>
            <p>Each finding names its engine. Skipped checks stay in the report. A skip is not a pass.</p>
          </article>
        </div>
        <a class="text-link coverage-more" href={docsTests}>See what it tests <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="home-section" id="how" aria-labelledby="how-heading">
      <div class="wrap">
        <div class="section-intro">
          <div><p class="eyebrow">02 / The feedback loop</p><h2 id="how-heading">Scope. Scan. Fix. Repeat.</h2></div>
          <p>A short path from your running app to evidence you can review. Run it yourself, through your coding agent, or in CI.</p>
        </div>
        <ScanWorkflow />
      </div>
    </section>

    <section class="home-section agent-section" id="agent-skill" aria-labelledby="agent-skill-heading">
      <div class="wrap agent-layout">
        <div>
          <p class="eyebrow">03 / In your coding workflow</p>
          <h2 id="agent-skill-heading">Your agent already has the context.<br />Give it the skill.</h2>
          <p class="section-description">The Insidia skill walks your coding agent through setup, scanning, and report review. You choose the app and confirm the hosts.</p>
          <ul class="agent-checklist">
            <li><span aria-hidden="true">↗</span> Claude Code, Cursor, Codex, and other compatible agents</li>
            <li><span aria-hidden="true">↗</span> Local scans with findings you can inspect</li>
            <li><span aria-hidden="true">↗</span> Suggested fixes, followed by the same checks</li>
          </ul>
          <a class="text-link" href={docsAgent}>Read the agent setup guide <span aria-hidden="true">→</span></a>
        </div>
        <div class="agent-console">
          <CommandBlock label="01 — Install the skill" command={skillInstall} />
          <CommandBlock label="02 — Ask your coding agent" command={skillPrompt} />
          <p class="console-note">Node.js 22+ for the skill installer. Python 3.12+ for scans. The skill guides CLI installation with uv or pipx.</p>
          <a class="console-source" href={`https://github.com/${GITHUB_REPO}/blob/main/skills/insidia/SKILL.md`}>Inspect SKILL.md <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="home-section" id="breaks" aria-labelledby="features-heading">
      <div class="wrap">
        <div class="section-intro">
          <div><p class="eyebrow">04 / The details matter</p><h2 id="features-heading">A result you can work with.</h2></div>
          <p>Keep the target, the engine, and the evidence connected. Know what was tested and what still needs attention.</p>
        </div>
        <div class="feature-bento">
          <article class="bento-cell bento-wide">
            <span class="feature-index">01 / Evidence</span><h3>Follow the finding to the source.</h3>
            <p>Each finding names its engine and probe, with available evidence and remediation guidance. Detected secrets are masked.</p>
            <dl class="evidence-details"><div><dt>ENGINE</dt><dd>insidia</dd></div><div><dt>PROBE</dt><dd>prompt-injection.indirect</dd></div><div><dt>EVIDENCE</dt><dd>[AWS_ACCESS_KEY len=20 fp=3f9a1c07]</dd></div></dl>
            <span class="example-note">Illustrative finding</span>
          </article>
          <article class="bento-cell">
            <span class="feature-index">02 / Boundaries</span><h3>Your scan.<br />Your scope.</h3>
            <p>Start on localhost. Other hosts require explicit authorization in your configuration.</p>
            <pre class="bento-code"><code>scope:
  - host: staging.example.com
    authorized: true</code></pre>
          </article>
          <article class="bento-cell">
            <span class="feature-index">03 / Control</span><h3>Local by default.</h3>
            <p>Reports stay on your machine. Run the L1 baseline without a model, or configure your own supported endpoint.</p>
            <a class="text-link" href="/security">Data and scope <span aria-hidden="true">→</span></a>
          </article>
          <article class="bento-cell bento-wide">
            <span class="feature-index">04 / Your pipeline</span><h3>Review in a browser. Automate in CI.</h3>
            <p>Open the HTML report, hand JSON findings to your coding agent, or use SARIF in code scanning. Skipped checks remain visible.</p>
            <ul class="report-formats" aria-label="Report formats"><li><span>HTML</span>For review</li><li><span>JSON</span>For your agent</li><li><span>SARIF</span>For CI</li></ul>
            <a class="text-link" href="/docs/concepts/report/">Explore the report <span aria-hidden="true">→</span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="video-heading">
      <div class="wrap video-layout">
        <div><p class="eyebrow">A closer look</p><h2 id="video-heading">See the workflow.</h2><p class="section-description">From a configured target to a finding, a report, and a rerun. Preview the steps before trying them on your own app.</p><p class="example-note">The walkthrough uses illustrative scan data.</p><a class="text-link" href="/film">Watch the film and read the transcript <span aria-hidden="true">↗</span></a></div>
        <div><VideoModal client:visible sources={howtoVideo} thumbnail label="Watch the walkthrough" title="Insidia — scan walkthrough" /><noscript><p><a href={howtoVideo.transcript}>Read the walkthrough transcript</a></p></noscript></div>
      </div>
    </section>

    <section class="home-section" id="faq" aria-labelledby="faq-heading">
      <div class="wrap faq-layout">
        <div><p class="eyebrow">Before your first scan</p><h2 id="faq-heading">A few useful answers.</h2><p>Need help with a specific setup?</p><a class="text-link" href="/docs/">Open the documentation <span aria-hidden="true">↗</span></a></div>
        <FaqThread items={faqs} name="homepage-faq" />
      </div>
    </section>

    <GradientCTABanner heading="Find out what your app trusts." description="Run a scan. Review the evidence. Make the next change." primaryLabel="Set up the agent skill" primaryHref="#agent-skill" secondaryLabel="Install the CLI" secondaryHref="#install" />
  </main>
  <Footer />
  <PageAnalytics path={TRACKED_PATHS.site} />
</Base>
