---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Marquee from "../components/Marquee.astro";
import Exhibit from "../components/Exhibit.astro";
import StepCard from "../components/StepCard.astro";
import FeatureCard from "../components/FeatureCard.astro";
import InstallLine from "../components/InstallLine.tsx";
import TraceHero from "../components/TraceHero.tsx";
import VideoModal from "../components/VideoModal.tsx";
import { engineBrands, stackBrands } from "../content/brands";
import { GITHUB_REPO } from "../content/install";
import { filmVideo, howtoVideo } from "../lib/video";
import PageAnalytics from "../components/PageAnalytics.astro";
import { TRACKED_PATHS } from "../lib/analytics";
import { docsAgent, docsQuickstart, docsTests } from "../lib/paths";

const description = "Check your AI app, agent, or API for security issues. Run Insidia locally or through your coding agent, then review the findings and suggested fixes in one report.";
const skillInstall = `npx skills add ${GITHUB_REPO}`;
const skillPrompt = `Use the Insidia skill to test my app at http://127.0.0.1:8080/chat.
Only scan localhost. Review the findings and open the report when you're done.`;
const faqs = [
  ["What can I test?", "AI apps, agents, web apps, and APIs. Insidia checks areas such as prompt injection, data leakage, and application vulnerabilities. Available checks depend on your target and installed engines. Some checks only work on the project's test apps."],
  ["Does my scan data leave my machine?", "The CLI runs locally and sends no telemetry. A scan contacts your configured target and any model endpoint you choose. Reports are saved on your machine."],
  ["Do I need an API key or a model?", "You can run the L1 baseline without a model or model API key. Checks that need a model are skipped unless you configure one. External engines may need additional setup."],
  ["How do I use the agent skill?", "Run npx skills add Rushi-Balapure/Insidia-Labs in your project and select your agent. Then ask it to use Insidia on your running app. The skill guides setup, scanning, and report review. You confirm which hosts it may test."],
  ["Can I test a deployed app?", "Yes, if you own it or have permission to test it. Add the host to insidia.yaml with authorized: true and confirm the scan with --yes. Start on localhost or staging while you set up your checks."],
  ["What does it cost?", "The CLI and agent skill are free. You do not need an Insidia account. Any paid model services you configure have their own costs. Insidia Cloud is in development; pricing has not been announced."],
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "Insidia Labs",
      url: Astro.site?.href,
      logo: new URL("/brand/mark-small.svg", Astro.site).href,
      email: "insidialabs@gmail.com",
      description,
    },
    {
      "@type": "SoftwareApplication",
      name: "Insidia",
      applicationCategory: "SecurityApplication",
      operatingSystem: "Linux, macOS, Windows",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      description: "CLI for security testing of AI apps, agents, web apps, and APIs. Runs on your machine. Every finding names the engine that produced it.",
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map(([name, text]) => ({
        "@type": "Question",
        name,
        acceptedAnswer: { "@type": "Answer", text },
      })),
    },
  ],
};
const scopeYaml = `$ insidia init --url http://127.0.0.1:8080/chat
$ insidia doctor`;
const scanRows = `support-bot
  ✔ ai.prompt_injection_direct     pass
  ✘ ai.prompt_injection_indirect   FAIL
  ✔ ai.data_leakage                pass`;
const rerunRows = `$ insidia rerun
  ✔ ai.prompt_injection_indirect   pass   insidia
POLICY PASSED · exit 0`;
const retrieval = `def build_prompt(question, docs):
    context = "\\n".join(d.text for d in docs)   # uploaded files, unfiltered
    return SYSTEM + context + question`;
---
<Base title="Insidia Labs | Security testing for AI apps and agents" description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Header />
  <main id="content">
    <div class="wrap hero">
      <div>
        <h1>Your AI agent is your newest attack surface.</h1>
        <p class="lede">{description}</p>
        <div class="cta-row">
          <a class="btn" href="#agent-skill">Use with your agent</a>
          <a class="btn ghost" href="#install">Install the CLI</a>
          <VideoModal client:load sources={filmVideo} />
        </div>
        <div id="install">
          <InstallLine client:load />
        </div>
        <p class="muted install-more">Free CLI and agent skill · Python 3.12+ · No account required. <a href={docsQuickstart}>Run your first scan.</a></p>
      </div>
      <TraceHero which="blocked" live />
    </div>

    <section class="block" id="agent-skill" aria-labelledby="agent-skill-heading">
      <div class="wrap">
        <p class="kicker">For Claude Code, Cursor, Codex, and other skill-compatible agents</p>
        <h2 id="agent-skill-heading">Let your coding agent run the scan.</h2>
        <p class="lede">The Insidia skill gives your agent the steps to set up a scan, review the findings, and open your report. You choose the app and confirm what it may test.</p>
        <div class="grid-2">
          <article class="card">
            <h3>1. Install the skill</h3>
            <p>Run this in your project directory, then select your coding agent when prompted.</p>
            <Exhibit file="Terminal" code={skillInstall} />
            <p class="muted install-more">Requires Node.js 22+. Scans require Python 3.12+; the skill guides your agent through installing the CLI with uv or pipx.</p>
          </article>
          <article class="card">
            <h3>2. Tell your agent what to test</h3>
            <p>Start your app and replace the example URL with its address.</p>
            <Exhibit file="Prompt for your coding agent" code={skillPrompt} />
            <p class="muted install-more">Review the report, ask your agent to help with a fix, and repeat the scan.</p>
          </article>
        </div>
        <div class="cta-row">
          <a class="btn ghost" href={docsAgent}>Agent setup guide</a>
          <a href={`https://github.com/${GITHUB_REPO}/blob/main/skills/insidia/SKILL.md`}>Read the skill</a>
        </div>
      </div>
    </section>

    <section class="howto-band" aria-labelledby="howto-heading">
      <div class="wrap">
        <h2 id="howto-heading">See the scan workflow</h2>
        <video class="howto-player" controls playsInline poster={howtoVideo.poster} preload="metadata">
          <source src={howtoVideo.webm} type="video/webm" />
          <source src={howtoVideo.mp4} type="video/mp4" />
          <track kind="captions" src={howtoVideo.vtt} srcLang="en" label="English" default />
        </video>
      </div>
    </section>

    <div class="marquee-band">
      <Marquee label="For the apps and agents you build" items={stackBrands} />
      <Marquee label="Explore the available engine integrations" items={engineBrands} />
    </div>

    <section class="block" id="problem">
      <div class="wrap">
        <h2>What happens when your app trusts the wrong input?</h2>
        <p class="lede">An uploaded document can carry instructions your agent was never meant to follow. Test how your app handles that input, alongside the APIs and tools it can reach.</p>
        <Exhibit
          file="support_bot/retrieval.py"
          code={retrieval}
          annotation="Uploaded text is mixed with trusted instructions. An attacker can use it to redirect the bot."
        />
        <ol class="beats">
          <li>
            <p class="kicker">01</p>
            <h3>Check the AI behavior</h3>
            <p>Look for ways untrusted input can redirect a response or expose data.</p>
          </li>
          <li>
            <p class="kicker">02</p>
            <h3>Check the connected app</h3>
            <p>Include the web app and API your agent relies on in your testing.</p>
          </li>
          <li>
            <p class="kicker">03</p>
            <h3>Review the evidence</h3>
            <p>Use the findings to decide what to fix, then repeat the checks.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="block" id="how">
      <div class="wrap">
        <h2>From a running app to a report you can act on.</h2>
        <p class="lede">Run these steps yourself or let the skill guide your coding agent.</p>
        <div class="grid-3">
          <StepCard n="01" title="Choose your target" text="Start your app, set its URL, and check your setup. Insidia saves your target and allowed hosts in insidia.yaml.">
            <Exhibit file="Set up a local scan" code={scopeYaml} />
          </StepCard>
          <StepCard n="02" title="Run the checks" text="Run insidia scan --policy L1 for the baseline without a model. Review the findings and coverage to see which checks ran and which were skipped.">
            <Exhibit file="insidia scan" code={scanRows} representative />
          </StepCard>
          <StepCard n="03" title="Review, fix, and repeat" text="Open your report with insidia report --open. Review the evidence and suggested fixes, update your app, then use insidia rerun to repeat the checks.">
            <Exhibit file="insidia rerun" code={rerunRows} representative />
          </StepCard>
        </div>
      </div>
    </section>

    <section class="block" id="breaks">
      <div class="wrap">
        <h2>Keep the scan in your workflow.</h2>
        <div class="grid-4">
          <FeatureCard
            title="Choose what gets tested"
            code={`scope:\n  - host: staging.example.com\n    authorized: true`}
            line="Start on localhost. Add staging or other hosts you have permission to test."
          />
          <FeatureCard
            title="Findings with evidence"
            code={`engine: insidia\nprobe: prompt-injection.indirect\nevidence: [AWS_ACCESS_KEY len=20 fp=3f9a1c07]\nfix: keep uploaded text out of the system prompt`}
            line="Review the available evidence, remediation guidance, and the engine behind each finding."
          />
          <FeatureCard
            title="Use your coding agent"
            code={skillInstall}
            line="Install the skill once, then ask your agent to scan your app and review the report."
          />
          <FeatureCard
            title="Run on your machine"
            code={`models:\n  attacker:\n    provider: openai-compatible\n    base_url: http://127.0.0.1:11434/v1\n    model: llama3.1`}
            line="Scans run on your machine. Use a supported model endpoint, or run the baseline without a model."
          />
        </div>
      </div>
    </section>

    <section class="block" id="faq">
      <div class="wrap">
        <h2>FAQ</h2>
        {faqs.map(([q, a], i) => (
          <details class="faq">
            <summary>{q}</summary>
            <p>
              {a}
              {i === 0 ? <> See <a href={docsTests}>what it tests</a>.</> : null}
              {i === 3 ? <> Follow the <a href={docsAgent}>agent setup guide</a>.</> : null}
            </p>
          </details>
        ))}
      </div>
    </section>

    <section class="block end-cta">
      <div class="wrap end-grid">
        <div>
          <h2>Start with the app you're building.</h2>
          <p class="lede">Use Insidia from your terminal or through your coding agent. Run a local scan and see what needs attention.</p>
          <div class="cta-row">
            <a class="btn" href="#agent-skill">Set up the agent skill</a>
            <a class="btn ghost" href={docsQuickstart}>CLI quickstart</a>
          </div>
        </div>
        <TraceHero which="clear" />
      </div>
    </section>
  </main>
  <Footer />
  <PageAnalytics path={TRACKED_PATHS.site} />
</Base>
