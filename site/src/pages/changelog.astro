---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { changelog } from "../content/changelog";

const description = "What has shipped publicly at Insidia Labs. The product is still in development.";
---
<Base title="Changelog | Insidia Labs" description={description} path="/changelog">
  <Header />
  <main id="content" class="wrap" style="padding:3rem 0 4rem">
    <h1>Changelog</h1>
    <p class="lede">Public notes only. The product is in development, so this list starts with the site, not a launch.</p>
    {changelog.map((entry) => (
      <article class="log-item">
        <time datetime={entry.date}>{entry.date}</time>
        <div><h2>{entry.title}</h2><p class="muted">{entry.body}</p></div>
      </article>
    ))}
  </main>
  <Footer />
</Base>
