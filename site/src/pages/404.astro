---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { docsHome, docsQuickstart } from "../lib/paths";
---
<Base title="Page not found | Insidia Labs" description="Find your way back to Insidia or its documentation." path="/404">
  <meta slot="head" name="robots" content="noindex" />
  <Header />
  <main id="content" class="wrap" style="padding:4rem 0">
    <p class="kicker">404</p>
    <h1>This page could not be found.</h1>
    <p class="lede">The link may have changed. You can return to the site or find what you need in the docs.</p>
    <p><a href="/">Back to the site</a> · <a href={docsHome}>Browse the docs</a> · <a href={docsQuickstart}>Run your first scan</a></p>
  </main>
  <Footer />
</Base>
